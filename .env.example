# URL de conexao com o PostgreSQL
# Formato: postgresql+psycopg2://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mercadez

# Chave secreta usada para assinar os tokens JWT.
# NUNCA reutilize o valor de exemplo em producao.
SECRET_KEY=troque-esta-chave-em-producao

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Tempo de expiracao do token, em minutos (1440 = 24h, igual ao backend Java)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=https://mercadez-ten.vercel.app,http://localhost:5500,http://127.0.0.1:5500
